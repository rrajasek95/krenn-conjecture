LIB "elim.lib";
ring S = 0, (K0000, K0100, K0212, K0222, K1011, K1021, K1100, K1111, K1121, K2000, K2100, K2200, K2212, K2222), dp;
ideal I = -6*K0000^2*K2222 - 6*K0000*K0222*K2000 - 12*K0000*K1100*K2222 - 18*K0000*K2200*K2222 - 12*K0222*K1100*K2000 - 18*K0222*K2000*K2200, -6*K0000^2*K1111 - 6*K0000*K0100*K1011 - 12*K0000*K1100*K1111 - 18*K0000*K1111*K2200 - 12*K0100*K1011*K1100 - 18*K0100*K1011*K2200, -6*K0000^2*K1111 - 6*K0000*K0100*K1011 - 12*K0000*K1100*K1111 - 18*K0000*K1111*K2200 - 12*K0100*K1011*K1100 - 18*K0100*K1011*K2200, -6*K0000*K1111*K2222 - 6*K0000*K1121*K2212 - 6*K0100*K1011*K2222 - 6*K0100*K1021*K2212 - 6*K0212*K1021*K2100 - 6*K0212*K1121*K2000 - 6*K0222*K1011*K2100 - 6*K0222*K1111*K2000, -6*K0000*K1111*K2222 - 6*K0000*K1121*K2212 - 12*K1100*K1111*K2222 - 12*K1100*K1121*K2212 - 18*K1111*K2200*K2222 - 18*K1121*K2200*K2212, -6*K0000*K1111*K2222 - 6*K0000*K1121*K2212 - 12*K1100*K1111*K2222 - 12*K1100*K1121*K2212 - 18*K1111*K2200*K2222 - 18*K1121*K2200*K2212, -6*K0000^2*K2222 - 6*K0000*K0222*K2000 - 12*K0000*K1100*K2222 - 18*K0000*K2200*K2222 - 12*K0222*K1100*K2000 - 18*K0222*K2000*K2200;
poly h = K0000^2*K1111*K2222 + 2*K0000*K1100*K1111*K2222 + 3*K0000*K1111*K2200*K2222;
ideal J = sat(I, ideal(h))[1];
string out = "SAT_w1_src:" + string(reduce(1, std(J)));
out;
exit;
