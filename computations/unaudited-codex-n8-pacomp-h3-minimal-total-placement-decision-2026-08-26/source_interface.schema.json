{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance": {
      "additionalProperties": false,
      "properties": {
        "exact_boundary_replay_required": {"const": true},
        "extra_descendants_allowed": {"const": false},
        "source_constructor_required": {"const": true},
        "symmetry_replay_required": {"const": true}
      },
      "required": ["exact_boundary_replay_required", "extra_descendants_allowed", "source_constructor_required", "symmetry_replay_required"],
      "type": "object"
    },
    "instances": {
      "const": ["AB/q23", "AB/q45", "AC/q23", "AC/q45"]
    },
    "new_physical_constructor_registered": {"const": false},
    "outputs": {
      "const": [
        {"boundary": "L01=(2*D*q01-p0*s1-p1*s0)*H_2345", "filtration_component": 0, "name": "Lambda_01"},
        {"boundary": "2*((dD)*q01+D*(dq01))*r_DQ-((dp0)*s1+p0*(ds1))*r_PS01-((dp1)*s0+p1*(ds0))*r_PS10", "filtration_component": 1, "name": "Pi_r,01"}
      ]
    },
    "required_face_checks": {
      "const": [
        "top boundary has no t_B/t_C face",
        "18 selected tail faces have coefficients 2,-1,-1",
        "18 endpoint/direction faces have coefficients 2,-1,-1",
        "two mixed relative-C4 faces cancel termwise",
        "retained face equals R_ret exactly",
        "Pi_r correction equals -R_ret exactly",
        "no extra q/anchor/W/ridge/residue/Eq descendants",
        "AB/AC root naturality and q23/q45 cut covariance"
      ]
    },
    "schema": {"const": "PACOMP_H3_MINIMAL_TOTAL_PLACEMENT_INTERFACE_V1"},
    "status": {"const": "REQUIRED_UNCONSTRUCTED_FINITE_SOURCE_DECISION"},
    "symmetry": {
      "additionalProperties": false,
      "properties": {
        "AB_AC": {"const": "two literal root-labelled instances"},
        "cut_sigma": {"const": "covariant q23<->q45"},
        "tau": {"const": "anti-equivariant"}
      },
      "required": ["AB_AC", "cut_sigma", "tau"],
      "type": "object"
    }
  },
  "required": ["schema", "status", "new_physical_constructor_registered", "instances", "outputs", "required_face_checks", "symmetry", "acceptance"],
  "type": "object"
}
