    "group": {"type":"object","additionalProperties":false,"required":["group_id","ids","full_charge_scaled_U","irreducible_charge_scaled_U","terminal_K24_occurrences"],"properties":{"group_id":{"type":"string"},"ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"full_charge_scaled_U":{"type":"string","pattern":"^-?[0-9]+$"},"irreducible_charge_scaled_U":{"type":"string","pattern":"^-?[0-9]+$"},"terminal_K24_occurrences":{"type":"integer","minimum":0}}},
