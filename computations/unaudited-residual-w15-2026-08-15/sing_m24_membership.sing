ring r = 0,(z0,z1,z2,z3,z4,z5,z6,z7,z8,z9,z10,z11,z12,z13,z14,z15,z16,z17,z18,z19,z20,z21,z22,z23,z24,z25),dp;
poly q1 = z1*z17*z19*z25+z1*z17*z21*z24+z4*z11*z19*z25+z4*z11*z21*z24+z6*z9*z19*z25+z6*z9*z21*z24+z8*z13*z17*z24;
poly q2 = z1*z17*z20*z25+z1*z17*z22*z24+z4*z11*z20*z25+z4*z11*z22*z24+z6*z9*z20*z25+z6*z9*z22*z24+z8*z14*z17*z24;
poly q3 = z2*z17*z19*z25+z2*z17*z21*z24+z4*z12*z19*z25+z4*z12*z21*z24+z6*z10*z19*z25+z6*z10*z21*z24+z8*z15*z17*z24;
poly q4 = z2*z17*z20*z25+z2*z17*z22*z24+z4*z12*z20*z25+z4*z12*z22*z24+z6*z10*z20*z25+z6*z10*z22*z24+z8*z16*z17*z24;
poly q5 = z0*z17*z20*z25+z0*z17*z22*z24+z3*z11*z20*z25+z3*z11*z22*z24+z5*z9*z20*z25+z5*z9*z22*z24+z7*z14*z17*z24;
poly q6 = z2*z17*z18*z25+z2*z17*z21*z23+z4*z12*z18*z25+z4*z12*z21*z23+z6*z10*z18*z25+z6*z10*z21*z23+z8*z15*z17*z23;
poly gc = z0*z17*z18*z25+z0*z17*z21*z23+z3*z11*z18*z25+z3*z11*z21*z23+z5*z9*z18*z25+z5*z9*z21*z23+z7*z13*z17*z23;
poly mm = z8*z8*z8*z8*z16*z16*z17*z17*z17*z24*z24*z24;
ideal Jid = q1,q2,q3,q4,q5,q6;
ideal GB = groebner(Jid);
poly nf = reduce(mm*gc, GB);
"multiplier_times_constant_word_reduces_to_zero:"; (nf==0);
poly nf2 = reduce(gc, GB);
"CONTROL_constant_word_alone_reduces_to_zero(expect 0):"; (nf2==0);
ideal Jd1 = q2,q3,q4,q5,q6;
poly nd1 = reduce(mm*gc, groebner(Jd1));
"CONTROL_drop_w1_still_reduces_to_zero(expect 0):"; (nd1==0);
ideal Jd2 = q1,q3,q4,q5,q6;
poly nd2 = reduce(mm*gc, groebner(Jd2));
"CONTROL_drop_w2_still_reduces_to_zero(expect 0):"; (nd2==0);
ideal Jd3 = q1,q2,q4,q5,q6;
poly nd3 = reduce(mm*gc, groebner(Jd3));
"CONTROL_drop_w3_still_reduces_to_zero(expect 0):"; (nd3==0);
ideal Jd4 = q1,q2,q3,q5,q6;
poly nd4 = reduce(mm*gc, groebner(Jd4));
"CONTROL_drop_w4_still_reduces_to_zero(expect 0):"; (nd4==0);
ideal Jd5 = q1,q2,q3,q4,q6;
poly nd5 = reduce(mm*gc, groebner(Jd5));
"CONTROL_drop_w5_still_reduces_to_zero(expect 0):"; (nd5==0);
ideal Jd6 = q1,q2,q3,q4,q5;
poly nd6 = reduce(mm*gc, groebner(Jd6));
"CONTROL_drop_w6_still_reduces_to_zero(expect 0):"; (nd6==0);
quit;
