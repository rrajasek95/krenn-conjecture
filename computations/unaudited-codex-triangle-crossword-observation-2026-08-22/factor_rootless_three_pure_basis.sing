// Exact factorization of the 19+7+1 global triangle-observation basis.
// Slice 0 is outside word 11222, slice 1 is 00000, slice 2 is 11111.
ring R=0,(u00,u01,u02,u10,u11,u12,u20,u21,u22,
          v00,v01,v02,v10,v11,v12,v20,v21,v22,
          w00,w01,w02,w10,w11,w12,w20,w21,w22),dp;
matrix M[27][27];
M[1,1]=u00; M[1,10]=v00; M[1,19]=w00;
M[2,1]=u01; M[2,11]=v00; M[2,20]=w00;
M[3,1]=u02; M[3,12]=v00; M[3,21]=w00;
M[4,2]=u00; M[4,10]=v01; M[4,22]=w00;
M[5,2]=u01; M[5,11]=v01; M[5,23]=w00;
M[6,3]=u00; M[6,10]=v02; M[6,25]=w00;
M[7,3]=u01; M[7,11]=v02; M[7,26]=w00;
M[8,3]=u02; M[8,12]=v02; M[8,27]=w00;
M[9,4]=u00; M[9,13]=v00; M[9,19]=w01;
M[10,4]=u01; M[10,14]=v00; M[10,20]=w01;
M[11,4]=u02; M[11,15]=v00; M[11,21]=w01;
M[12,5]=u00; M[12,13]=v01; M[12,22]=w01;
M[13,5]=u02; M[13,15]=v01; M[13,24]=w01;
M[14,6]=u00; M[14,13]=v02; M[14,25]=w01;
M[15,7]=u00; M[15,16]=v00; M[15,19]=w02;
M[16,7]=u01; M[16,17]=v00; M[16,20]=w02;
M[17,7]=u02; M[17,18]=v00; M[17,21]=w02;
M[18,8]=u00; M[18,16]=v01; M[18,22]=w02;
M[19,9]=u00; M[19,16]=v02; M[19,25]=w02;
M[20,1]=u11; M[20,11]=v10; M[20,20]=w10;
M[21,1]=u12; M[21,12]=v10; M[21,21]=w10;
M[22,2]=u10; M[22,10]=v11; M[22,22]=w10;
M[23,2]=u11; M[23,11]=v11; M[23,23]=w10;
M[24,3]=u10; M[24,10]=v12; M[24,25]=w10;
M[25,4]=u10; M[25,13]=v10; M[25,19]=w11;
M[26,7]=u10; M[26,16]=v10; M[26,19]=w12;
M[27,1]=u20; M[27,10]=v20; M[27,19]=w20;

poly D=det(M);
poly H=-u20*v10*w00+u10*v20*w00+u20*v00*w10
       -u00*v20*w10-u10*v00*w20+u00*v10*w20;
poly expected=-w01*(-u10*w00+u00*w10)*(-u11*w00+u01*w10)
              *(-v10*w00+v00*w10)*(-v11*w00+v01*w10)
              *H*(-u10*v00+u00*v10)^2*w00^3*u00^4*v00^4;
if (D-expected!=0)
{
  ERROR("19+7+1 determinant factorization failed");
}
print("PASS terms="+string(size(D))+" holonomy_power=1");
exit;
