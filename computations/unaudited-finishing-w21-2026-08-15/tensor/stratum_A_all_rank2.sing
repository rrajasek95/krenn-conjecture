LIB "primdec.lib";
LIB "elim.lib";
ring Rng = 0,(p11,p12,p21,p22,q11,q12,q21,q22,r11,r12,r21,r22,s11,s12,s21,s22,t11,t12,t21,t22,u11,u12,u21,u22),dp;
ideal zzgI = p11*u11 + q11*t11 + r11*s11,
  p11*u12 + q11*t12 + r12*s11,
  p11*u21 + q12*t11 + r11*s12,
  p11*u22 + q12*t12 + r12*s12,
  p12*u11 + q11*t21 + r11*s21,
  p12*u12 + q11*t22 + r12*s21,
  p12*u21 + q12*t21 + r11*s22,
  p12*u22 + q12*t22 + r12*s22,
  p21*u11 + q21*t11 + r21*s11,
  p21*u12 + q21*t12 + r22*s11,
  p21*u21 + q22*t11 + r21*s12,
  p21*u22 + q22*t12 + r22*s12,
  p22*u11 + q21*t21 + r21*s21,
  p22*u12 + q21*t22 + r22*s21,
  p22*u21 + q22*t21 + r21*s22,
  p22*u22 + q22*t22 + r22*s22;
list zzgM0 = sat(zzgI, ideal(p11*p22 - p12*p21));
ideal zzgI = zzgM0[1];
list zzgM1 = sat(zzgI, ideal(q11*q22 - q12*q21));
ideal zzgI = zzgM1[1];
list zzgM2 = sat(zzgI, ideal(r11*r22 - r12*r21));
ideal zzgI = zzgM2[1];
list zzgM3 = sat(zzgI, ideal(s11*s22 - s12*s21));
ideal zzgI = zzgM3[1];
list zzgM4 = sat(zzgI, ideal(t11*t22 - t12*t21));
ideal zzgI = zzgM4[1];
list zzgM5 = sat(zzgI, ideal(u11*u22 - u12*u21));
ideal zzgI = zzgM5[1];
ideal zzgG = std(zzgI);
printf("DIM %s", dim(zzgG));
printf("ISUNIT %s", size(zzgG) == 1 && leadmonom(zzgG[1]) == 1);
printf("GENS %s", string(zzgG));
quit;
