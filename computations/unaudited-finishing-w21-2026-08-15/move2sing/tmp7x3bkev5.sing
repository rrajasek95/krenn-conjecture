LIB "elim.lib";
ring zzr = 0,(zzv0,zzv1,zzv2,zzv3,zzv4,zzv5,zzv6,zzv7,zzv8,zzv9,zzv10,zzv11,zzv12),dp;
poly zzg1 = zzv0*zzv4*zzv8+zzv0*zzv5*zzv6+zzv1*zzv3*zzv8+zzv1*zzv5*zzv10+zzv1*zzv8*zzv10+zzv2*zzv3*zzv6+zzv2*zzv4*zzv10+zzv2*zzv6*zzv10+zzv4*zzv8*zzv10+zzv5*zzv6*zzv10;
poly zzg2 = zzv0*zzv5+zzv0*zzv8+zzv1*zzv5*zzv11+zzv1*zzv8*zzv11+zzv2*zzv3+zzv2*zzv4*zzv11+zzv2*zzv6*zzv11+zzv3*zzv8+zzv4*zzv8*zzv11+zzv5*zzv6*zzv11;
poly zzg3 = zzv0*zzv4+zzv0*zzv6+zzv1*zzv3+zzv1*zzv5*zzv12+zzv1*zzv8*zzv12+zzv2*zzv4*zzv12+zzv2*zzv6*zzv12+zzv3*zzv6+zzv4*zzv8*zzv12+zzv5*zzv6*zzv12;
poly zzg4 = zzv0*zzv4*zzv9+zzv0*zzv5*zzv7+zzv1*zzv3*zzv9+zzv1*zzv5+zzv1*zzv9*zzv10+zzv2*zzv3*zzv7+zzv2*zzv4+zzv2*zzv7*zzv10+zzv4*zzv9*zzv10+zzv5*zzv7*zzv10;
poly zzg5 = zzv0*zzv9+zzv1*zzv9*zzv11+zzv2+zzv2*zzv7*zzv11+zzv3*zzv9+zzv4*zzv9*zzv11+zzv5+zzv5*zzv7*zzv11;
poly zzg6 = zzv0*zzv7+zzv1+zzv1*zzv9*zzv12+zzv2*zzv7*zzv12+zzv3*zzv7+zzv4+zzv4*zzv9*zzv12+zzv5*zzv7*zzv12;
ideal zzI = zzg1,zzg2,zzg3,zzg4,zzg5,zzg6;
ideal zzS = std(zzI);
list zzL;
zzL = sat(zzS, ideal(zzv0));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv1));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv2));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv3));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv4));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv5));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv6,zzv7));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv8,zzv9));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv10,zzv11,zzv12));
zzS = std(zzL[1]);
"MARK_UNIT"; reduce(1,zzS);
"MARK_DIM"; dim(zzS);
quit;
