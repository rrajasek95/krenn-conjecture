LIB "elim.lib";
ring zzr = 0,(zzv0,zzv1,zzv2,zzv3,zzv4,zzv5,zzv6,zzv7,zzv8,zzv9,zzv10,zzv11,zzv12,zzv13,zzv14,zzv15),dp;
poly zzg1 = zzv0*zzv6*zzv14+zzv0*zzv10*zzv14+zzv2*zzv4*zzv14+zzv2*zzv8*zzv14+zzv4*zzv10*zzv14+zzv6*zzv8*zzv14;
poly zzg2 = zzv0*zzv6*zzv15+zzv0*zzv10*zzv15+zzv2*zzv4*zzv15+zzv2*zzv8*zzv15+zzv4*zzv10*zzv15+zzv6*zzv8*zzv15;
poly zzg3 = zzv0*zzv6*zzv12+zzv0*zzv11*zzv14+zzv2+zzv2*zzv4*zzv12+zzv2*zzv9*zzv14+zzv4*zzv11*zzv14+zzv6+zzv6*zzv9*zzv14;
poly zzg4 = zzv0+zzv0*zzv6*zzv13+zzv0*zzv11*zzv15+zzv2*zzv4*zzv13+zzv2*zzv9*zzv15+zzv4+zzv4*zzv11*zzv15+zzv6*zzv9*zzv15;
poly zzg5 = zzv0*zzv7*zzv14+zzv0*zzv10*zzv12+zzv2+zzv2*zzv5*zzv14+zzv2*zzv8*zzv12+zzv5*zzv10*zzv14+zzv7*zzv8*zzv14+zzv10;
poly zzg6 = zzv0+zzv0*zzv7*zzv15+zzv0*zzv10*zzv13+zzv2*zzv5*zzv15+zzv2*zzv8*zzv13+zzv5*zzv10*zzv15+zzv7*zzv8*zzv15+zzv8;
poly zzg7 = zzv0*zzv7*zzv12+zzv0*zzv11*zzv12+zzv2*zzv5*zzv12+zzv2*zzv9*zzv12+zzv5*zzv11*zzv14+zzv7+zzv7*zzv9*zzv14+zzv11;
poly zzg8 = zzv0*zzv7*zzv13+zzv0*zzv11*zzv13+zzv2*zzv5*zzv13+zzv2*zzv9*zzv13+zzv5+zzv5*zzv11*zzv15+zzv7*zzv9*zzv15+zzv9;
poly zzg9 = zzv1*zzv6*zzv14+zzv1*zzv10*zzv14+zzv3*zzv4*zzv14+zzv3*zzv8*zzv14+zzv4*zzv10*zzv12+zzv6+zzv6*zzv8*zzv12+zzv10;
poly zzg10 = zzv1*zzv6*zzv15+zzv1*zzv10*zzv15+zzv3*zzv4*zzv15+zzv3*zzv8*zzv15+zzv4+zzv4*zzv10*zzv13+zzv6*zzv8*zzv13+zzv8;
poly zzg11 = zzv1*zzv6*zzv12+zzv1*zzv11*zzv14+zzv3+zzv3*zzv4*zzv12+zzv3*zzv9*zzv14+zzv4*zzv11*zzv12+zzv6*zzv9*zzv12+zzv11;
poly zzg12 = zzv1+zzv1*zzv6*zzv13+zzv1*zzv11*zzv15+zzv3*zzv4*zzv13+zzv3*zzv9*zzv15+zzv4*zzv11*zzv13+zzv6*zzv9*zzv13+zzv9;
poly zzg13 = zzv1*zzv7*zzv14+zzv1*zzv10*zzv12+zzv3+zzv3*zzv5*zzv14+zzv3*zzv8*zzv12+zzv5*zzv10*zzv12+zzv7+zzv7*zzv8*zzv12;
poly zzg14 = zzv1+zzv1*zzv7*zzv15+zzv1*zzv10*zzv13+zzv3*zzv5*zzv15+zzv3*zzv8*zzv13+zzv5+zzv5*zzv10*zzv13+zzv7*zzv8*zzv13;
poly zzg15 = zzv1*zzv7*zzv12+zzv1*zzv11*zzv12+zzv3*zzv5*zzv12+zzv3*zzv9*zzv12+zzv5*zzv11*zzv12+zzv7*zzv9*zzv12;
poly zzg16 = zzv1*zzv7*zzv13+zzv1*zzv11*zzv13+zzv3*zzv5*zzv13+zzv3*zzv9*zzv13+zzv5*zzv11*zzv13+zzv7*zzv9*zzv13;
ideal zzI = zzg1,zzg2,zzg3,zzg4,zzg5,zzg6,zzg7,zzg8,zzg9,zzg10,zzg11,zzg12,zzg13,zzg14,zzg15,zzg16;
ideal zzS = std(zzI);
list zzL;
zzL = sat(zzS, ideal(zzv0,zzv1));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv2,zzv3));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv4,zzv5));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv6,zzv7));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv8,zzv9));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv10,zzv11));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv12,zzv13));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv14,zzv15));
zzS = std(zzL[1]);
"MARK_UNIT"; reduce(1,zzS);
"MARK_DIM"; dim(zzS);
quit;
