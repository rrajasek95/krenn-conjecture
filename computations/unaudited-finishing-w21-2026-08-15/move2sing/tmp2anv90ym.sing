LIB "elim.lib";
ring zzr = 0,(zzv0,zzv1,zzv2,zzv3,zzv4,zzv5,zzv6,zzv7,zzv8,zzv9,zzv10,zzv11,zzv12,zzv13),dp;
poly zzg1 = zzv0*zzv5*zzv9*zzv11+zzv1*zzv5+zzv1*zzv5*zzv7*zzv11+zzv2*zzv3*zzv9+zzv2*zzv9*zzv11+zzv5*zzv9;
poly zzg2 = zzv0*zzv5+zzv0*zzv5*zzv9*zzv12+zzv1*zzv5*zzv7*zzv12+zzv2+zzv2*zzv3*zzv7+zzv2*zzv9*zzv12+zzv5*zzv7;
poly zzg3 = zzv0*zzv3*zzv9+zzv0*zzv5*zzv9*zzv13+zzv1+zzv1*zzv3*zzv7+zzv1*zzv5*zzv7*zzv13+zzv2*zzv9*zzv13+zzv9;
poly zzg4 = zzv0*zzv5*zzv10*zzv11+zzv1*zzv3+zzv1*zzv5*zzv8*zzv11+zzv1*zzv11+zzv2*zzv3*zzv10+zzv2*zzv10*zzv11+zzv5*zzv10;
poly zzg5 = 1+zzv0*zzv3+zzv0*zzv5*zzv10*zzv12+zzv1*zzv5*zzv8*zzv12+zzv1*zzv12+zzv2*zzv3*zzv8+zzv2*zzv10*zzv12+zzv5*zzv8;
poly zzg6 = zzv0*zzv3*zzv10+zzv0*zzv5*zzv10*zzv13+zzv1*zzv3*zzv8+zzv1*zzv5*zzv8*zzv13+zzv1*zzv13+zzv2*zzv10*zzv13+zzv10;
poly zzg7 = zzv0*zzv6*zzv9*zzv11+zzv1*zzv6+zzv1*zzv6*zzv7*zzv11+zzv2+zzv2*zzv4*zzv9+zzv2*zzv7*zzv11+zzv6*zzv9;
poly zzg8 = zzv0*zzv6+zzv0*zzv6*zzv9*zzv12+zzv1*zzv6*zzv7*zzv12+zzv2*zzv4*zzv7+zzv2*zzv7*zzv12+zzv6*zzv7;
poly zzg9 = zzv0+zzv0*zzv4*zzv9+zzv0*zzv6*zzv9*zzv13+zzv1*zzv4*zzv7+zzv1*zzv6*zzv7*zzv13+zzv2*zzv7*zzv13+zzv7;
poly zzg10 = 1+zzv0*zzv6*zzv10*zzv11+zzv0*zzv11+zzv1*zzv4+zzv1*zzv6*zzv8*zzv11+zzv2*zzv4*zzv10+zzv2*zzv8*zzv11+zzv6*zzv10;
poly zzg11 = zzv0*zzv4+zzv0*zzv6*zzv10*zzv12+zzv0*zzv12+zzv1*zzv6*zzv8*zzv12+zzv2*zzv4*zzv8+zzv2*zzv8*zzv12+zzv6*zzv8;
poly zzg12 = zzv0*zzv4*zzv10+zzv0*zzv6*zzv10*zzv13+zzv0*zzv13+zzv1*zzv4*zzv8+zzv1*zzv6*zzv8*zzv13+zzv2*zzv8*zzv13+zzv8;
ideal zzI = zzg1,zzg2,zzg3,zzg4,zzg5,zzg6,zzg7,zzg8,zzg9,zzg10,zzg11,zzg12;
ideal zzS = std(zzI);
list zzL;
zzL = sat(zzS, ideal(zzv0));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv1));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv2));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv3,zzv4));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv5,zzv6));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv7,zzv8));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv9,zzv10));
zzS = std(zzL[1]);
zzL = sat(zzS, ideal(zzv11,zzv12,zzv13));
zzS = std(zzL[1]);
"MARK_UNIT"; reduce(1,zzS);
"MARK_DIM"; dim(zzS);
quit;
