ring r=(0,w),(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,s,z),dp;
minpoly=w2+w+1;
ideal I=(3)*x1+(-3-3w)*x3,(3)*x4+(3)*x5,(1)*x1*x10+(-1-1w)*x3*x10,(1)*x6*x9+(1)*x7*x8,(1)*x4*x10+(1)*x5*x10,(3)*x2+(3)*x3*x4,(1)*x6*x9*x10+(1)*x7*x8*x10,(1)*x1*x6*x9+(1)*x1*x7*x8,(1)*x2*x10+(1)*x3*x4*x10,(1)*x1*x6*x9*x10+(1)*x1*x7*x8*x10,(1)*x2*x6*x9+(1)*x2*x7*x8,s*x1*x2*x3*x4*x5*x6*x7*x8*x9*x10-1,z*((1)*x2*x6*x9*x10+(1)*x2*x7*x8*x10)-1;
option(redSB);
ideal G=std(I);
print("SENTINEL_BEGIN");
size(G);
vdim(G);
reduce(1,G);
print("SENTINEL_END");
quit;
