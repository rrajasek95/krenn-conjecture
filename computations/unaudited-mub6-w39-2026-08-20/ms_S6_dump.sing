LIB "modstd.lib";
ring zzR = 0,(u2,u3,u4,u5,u6,v2,v3,v4,v5,v6),dp;
option(redSB);
ideal zzI = (3*((2)+(2)*u2+(2)*u3+(2)*u4+(2)*u5+(2)*u6)^2+((2)*v2+(2)*v3+(2)*v4+(2)*v5+(2)*v6)^2-72),(3*((2)+(2)*u2+(-1)*u3+(-1)*v3+(-1)*u4+(-1)*v4+(-1)*u5+(1)*v5+(-1)*u6+(1)*v6)^2+((2)*v2+(-1)*v3+(3)*u3+(-1)*v4+(3)*u4+(-1)*v5+(-3)*u5+(-1)*v6+(-3)*u6)^2-72),(3*((2)+(-1)*u2+(-1)*v2+(2)*u3+(-1)*u4+(1)*v4+(-1)*u5+(1)*v5+(-1)*u6+(-1)*v6)^2+((-1)*v2+(3)*u2+(2)*v3+(-1)*v4+(-3)*u4+(-1)*v5+(-3)*u5+(-1)*v6+(3)*u6)^2-72),(3*((2)+(-1)*u2+(-1)*v2+(-1)*u3+(1)*v3+(2)*u4+(-1)*u5+(-1)*v5+(-1)*u6+(1)*v6)^2+((-1)*v2+(3)*u2+(-1)*v3+(-3)*u3+(2)*v4+(-1)*v5+(3)*u5+(-1)*v6+(-3)*u6)^2-72),(3*((2)+(-1)*u2+(1)*v2+(-1)*u3+(1)*v3+(-1)*u4+(-1)*v4+(2)*u5+(-1)*u6+(-1)*v6)^2+((-1)*v2+(-3)*u2+(-1)*v3+(-3)*u3+(-1)*v4+(3)*u4+(2)*v5+(-1)*v6+(3)*u6)^2-72),(3*((2)+(-1)*u2+(1)*v2+(-1)*u3+(-1)*v3+(-1)*u4+(1)*v4+(-1)*u5+(-1)*v5+(2)*u6)^2+((-1)*v2+(-3)*u2+(-1)*v3+(3)*u3+(-1)*v4+(-3)*u4+(-1)*v5+(3)*u5+(2)*v6)^2-72),(3*u2^2+v2^2-3),(3*u3^2+v3^2-3),(3*u4^2+v4^2-3),(3*u5^2+v5^2-3),(3*u6^2+v6^2-3);
ideal zzG = modStd(zzI);
zzG = simplify(zzG,1);
// VERIFIED DIRECTION: every original generator must reduce to 0 mod zzG
int zzbad=0; int zzi;
for (zzi=1; zzi<=size(zzI); zzi++) { if (reduce(zzI[zzi],zzG)!=0) { zzbad=zzbad+1; } }
"ZZCONTAIN"; string(zzbad);
if (dim(zzG)!=0) { "ZZSTATUS NOTZERODIM"; quit; }
ideal zzB = kbase(zzG); int zzD = size(zzB);
"ZZSTATUS OK";
"ZZD"; string(zzD);
"ZZVDIM"; string(vdim(zzG));
"ZZBASIS";
int zzj; for (zzi=1; zzi<=zzD; zzi++) { string(zzB[zzi]); }
ideal zzP; int zzc=0;
for (zzi=1; zzi<=zzD; zzi++) { for (zzj=zzi; zzj<=zzD; zzj++) { zzc=zzc+1; zzP[zzc]=zzB[zzi]*zzB[zzj]; } }
ideal zzN = reduce(zzP, zzG);
link zzL = ":w ./ms_S6_nf.txt";
for (zzi=1; zzi<=zzc; zzi++) { write(zzL, string(zzN[zzi])); }
close(zzL);
"ZZDONE"; string(zzc);
quit;
