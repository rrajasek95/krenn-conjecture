ring zzR = (0,xx),(z1,z2,z3,z4,z5,y1,y2,y3,y4,y5),dp;
minpoly = xx^2+xx+1;
poly zzg0 = (xx^0*(1)+xx^0*(z1)+xx^0*(z2)+xx^0*(z3)+xx^0*(z4)+xx^0*(z5))*(xx^0*(1)+xx^0*(y1)+xx^0*(y2)+xx^0*(y3)+xx^0*(y4)+xx^0*(y5))-6;
poly zzg1 = (xx^0*(1)+xx^0*(z1)+xx^2*(z2)+xx^2*(z3)+xx^1*(z4)+xx^1*(z5))*(xx^0*(1)+xx^0*(y1)+xx^1*(y2)+xx^1*(y3)+xx^2*(y4)+xx^2*(y5))-6;
poly zzg2 = (xx^0*(1)+xx^2*(z1)+xx^0*(z2)+xx^1*(z3)+xx^1*(z4)+xx^2*(z5))*(xx^0*(1)+xx^1*(y1)+xx^0*(y2)+xx^2*(y3)+xx^2*(y4)+xx^1*(y5))-6;
poly zzg3 = (xx^0*(1)+xx^2*(z1)+xx^1*(z2)+xx^0*(z3)+xx^2*(z4)+xx^1*(z5))*(xx^0*(1)+xx^1*(y1)+xx^2*(y2)+xx^0*(y3)+xx^1*(y4)+xx^2*(y5))-6;
poly zzg4 = (xx^0*(1)+xx^1*(z1)+xx^1*(z2)+xx^2*(z3)+xx^0*(z4)+xx^2*(z5))*(xx^0*(1)+xx^2*(y1)+xx^2*(y2)+xx^1*(y3)+xx^0*(y4)+xx^1*(y5))-6;
poly zzg5 = (xx^0*(1)+xx^1*(z1)+xx^2*(z2)+xx^1*(z3)+xx^2*(z4)+xx^0*(z5))*(xx^0*(1)+xx^2*(y1)+xx^1*(y2)+xx^2*(y3)+xx^1*(y4)+xx^0*(y5))-6;
poly zzg6 = z1*y1-1;
poly zzg7 = z2*y2-1;
poly zzg8 = z3*y3-1;
poly zzg9 = z4*y4-1;
poly zzg10 = z5*y5-1;
ideal zzI = zzg0,zzg1,zzg2,zzg3,zzg4,zzg5,zzg6,zzg7,zzg8,zzg9,zzg10;
option(redSB);
ideal zzG = std(zzI);
"TAG S6";
"ngens"; size(zzG);
