// A6 independent membership battery for the m=24 kill
// legend: A01_00=v1, A01_10=v2, A01_12=v3, A02_00=v4, A02_10=v5, A03_00=v6, A03_10=v7, A07_00=v8, A07_10=v9, A12_00=v10, A12_20=v11, A13_00=v12, A13_20=v13, A14_00=v14, A14_01=v15, A14_20=v16, A14_21=v17, A23_00=v18, A45_00=v19, A45_02=v20, A45_12=v21, A47_00=v22, A47_10=v23, A56_00=v24, A56_20=v25, A67_00=v26
ring rr = 0,(v1,v2,v3,v4,v5,v6,v7,v8,v9,v10,v11,v12,v13,v14,v15,v16,v17,v18,v19,v20,v21,v22,v23,v24,v25,v26),dp;
poly p1 = v2*v18*v20*v26+v2*v18*v22*v25+v5*v12*v20*v26+v5*v12*v22*v25+v7*v10*v20*v26+v7*v10*v22*v25+v9*v14*v18*v25;
poly p2 = v2*v18*v21*v26+v2*v18*v23*v25+v5*v12*v21*v26+v5*v12*v23*v25+v7*v10*v21*v26+v7*v10*v23*v25+v9*v15*v18*v25;
poly p3 = v3*v18*v20*v26+v3*v18*v22*v25+v5*v13*v20*v26+v5*v13*v22*v25+v7*v11*v20*v26+v7*v11*v22*v25+v9*v16*v18*v25;
poly p4 = v3*v18*v21*v26+v3*v18*v23*v25+v5*v13*v21*v26+v5*v13*v23*v25+v7*v11*v21*v26+v7*v11*v23*v25+v9*v17*v18*v25;
poly p5 = v1*v18*v21*v26+v1*v18*v23*v25+v4*v12*v21*v26+v4*v12*v23*v25+v6*v10*v21*v26+v6*v10*v23*v25+v8*v15*v18*v25;
poly p6 = v3*v18*v19*v26+v3*v18*v22*v24+v5*v13*v19*v26+v5*v13*v22*v24+v7*v11*v19*v26+v7*v11*v22*v24+v9*v16*v18*v24;
poly gz = v1*v18*v19*v26+v1*v18*v22*v24+v4*v12*v19*v26+v4*v12*v22*v24+v6*v10*v19*v26+v6*v10*v22*v24+v8*v14*v18*v24;
poly kk = v9*v18*v25;
ideal J6 = p1,p2,p3,p4,p5,p6;
ideal J5 = p1,p2,p3,p5,p6;
ideal B6 = groebner(J6);
ideal B5 = groebner(J5);
"W15_mult_K3U1V21sq_times_G_in_J6"; (reduce(kk^3*v9*v17^2*gz, B6)==0);
"A6_mult_K3V21_times_G_in_J6"; (reduce(kk^3*v17*gz, B6)==0);
"A6_mult_K2V21_times_G_in_J6"; (reduce(kk^2*v17*gz, B6)==0);
"probe_KV21_times_G_in_J6"; (reduce(kk*v17*gz, B6)==0);
"probe_K2_times_G_in_J6"; (reduce(kk^2*gz, B6)==0);
"probe_V21_times_G_in_J6"; (reduce(v17*gz, B6)==0);
"CONTROL_G_alone_in_J6_expect_0"; (reduce(gz, B6)==0);
"A6_mult_K2V01V20_times_G_in_J5(FIVE WORDS)"; (reduce(kk^2*v15*v16*gz, B5)==0);
"W15_mult_times_G_in_J5_expect_0(their leave-one-out)"; (reduce(kk^3*v9*v17^2*gz, B5)==0);
"probe_KV01V20_times_G_in_J5"; (reduce(kk*v15*v16*gz, B5)==0);
"probe_K2V01_times_G_in_J5"; (reduce(kk^2*v15*gz, B5)==0);
"probe_K2V20_times_G_in_J5"; (reduce(kk^2*v16*gz, B5)==0);
"probe_V01V20_times_G_in_J5"; (reduce(v15*v16*gz, B5)==0);
"CONTROL_G_alone_in_J5_expect_0"; (reduce(gz, B5)==0);
poly cells = v9*v8*v18*v25*v14*v15*v16*v17;
ideal S6 = sat(J6, cells)[1];
"G_in_saturation_of_J6_by_cells"; (reduce(gz, groebner(S6))==0);
ideal S5 = sat(J5, cells)[1];
"G_in_saturation_of_J5_by_cells"; (reduce(gz, groebner(S5))==0);
ideal Jd1 = p2,p3,p5,p6;
ideal Sd1 = sat(Jd1, cells)[1];
"G_in_saturation_dropping_w1_expect_0"; (reduce(gz, groebner(Sd1))==0);
ideal Jd2 = p1,p3,p5,p6;
ideal Sd2 = sat(Jd2, cells)[1];
"G_in_saturation_dropping_w2_expect_0"; (reduce(gz, groebner(Sd2))==0);
ideal Jd3 = p1,p2,p5,p6;
ideal Sd3 = sat(Jd3, cells)[1];
"G_in_saturation_dropping_w3_expect_0"; (reduce(gz, groebner(Sd3))==0);
ideal Jd5 = p1,p2,p3,p6;
ideal Sd5 = sat(Jd5, cells)[1];
"G_in_saturation_dropping_w5_expect_0"; (reduce(gz, groebner(Sd5))==0);
ideal Jd6 = p1,p2,p3,p5;
ideal Sd6 = sat(Jd6, cells)[1];
"G_in_saturation_dropping_w6_expect_0"; (reduce(gz, groebner(Sd6))==0);
quit;
