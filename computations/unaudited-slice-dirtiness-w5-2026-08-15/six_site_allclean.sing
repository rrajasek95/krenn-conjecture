ring R = 0, (w13,w14,w15,w23,w24,w25,w34,w35,w45), dp;
ideal I = (1*1*w14*w15+1*1*w13*w15+1*1*w13*w14+1*1*1*w15+1*1*1*w14+1*1*1*w13),
  (1*1*w24*w25+1*1*w23*w25+1*1*w23*w24+1*1*1*w25+1*1*1*w24+1*1*1*w23),
  (1*1*w34*w35+1*1*w23*w35+1*1*w23*w34+1*1*w13*w35+1*1*w13*w34+1*1*w13*w23),
  (1*1*w34*w45+1*1*w24*w45+1*1*w24*w34+1*1*w14*w45+1*1*w14*w34+1*1*w14*w24),
  (1*1*w35*w45+1*1*w25*w45+1*1*w25*w35+1*1*w15*w45+1*1*w15*w35+1*1*w15*w25),
  (1*w13*w24*w25+1*w14*w23*w25+1*w15*w23*w24+w13*w14*1*w25+w13*w15*1*w24+w14*w15*1*w23),
  (1*1*w34*w35+1*w14*w23*w35+1*w15*w23*w34+1*w14*1*w35+1*w15*1*w34+w14*w15*1*w23),
  (1*1*w34*w45+1*w13*w24*w45+1*w15*w24*w34+1*w13*1*w45+1*w15*1*w34+w13*w15*1*w24),
  (1*1*w35*w45+1*w13*w25*w45+1*w14*w25*w35+1*w13*1*w45+1*w14*1*w35+w13*w14*1*w25),
  (1*1*w34*w35+1*w24*w13*w35+1*w25*w13*w34+1*w24*1*w35+1*w25*1*w34+w24*w25*1*w13),
  (1*1*w34*w45+1*w23*w14*w45+1*w25*w14*w34+1*w23*1*w45+1*w25*1*w34+w23*w25*1*w14),
  (1*1*w35*w45+1*w23*w15*w45+1*w24*w15*w35+1*w23*1*w45+1*w24*1*w35+w23*w24*1*w15),
  (1*w13*w24*w45+1*w23*w14*w45+1*w35*w14*w24+w13*w23*1*w45+w13*w35*1*w24+w23*w35*1*w14),
  (1*w13*w25*w45+1*w23*w15*w45+1*w34*w15*w25+w13*w23*1*w45+w13*w34*1*w25+w23*w34*1*w15),
  (1*w14*w25*w35+1*w24*w15*w35+1*w34*w15*w25+w14*w24*1*w35+w14*w34*1*w25+w24*w34*1*w15);
poly H = 1*w23*w45+1*w24*w35+1*w25*w34+1*w13*w45+1*w14*w35+1*w15*w34+1*1*w45+1*w14*w25+1*w15*w24+1*1*w35+1*w13*w25+1*w15*w23+1*1*w34+1*w13*w24+1*w14*w23;
option(redSB);
ideal G = std(I);
"dim(all-clean, gauge-fixed) ="; dim(G);
"1 in I ?"; reduce(1, G) == 0;
ideal J = I, H - 1;
ideal GJ = std(J);
"1 in (I + (haf-1)) ?  [1 means NO all-clean weighting with haf=1 in this chart]"; reduce(1, GJ) == 0;
"dim(all-clean and haf=1) ="; dim(GJ);
"vdim(all-clean and haf=1) ="; vdim(GJ);
LIB "elim.lib";
poly PR = 1; int i;
for (i = 1; i <= nvars(R); i++) { PR = PR * var(i); }
ideal SS = sat(GJ, PR)[1];
"1 in (all-clean, haf=1) : (prod free vars)^infty ?  [1 = every all-clean haf=1 weighting has a ZERO edge]"; reduce(1, std(SS)) == 0;
ideal SH = sat(G, PR)[1];
"dim(all-clean with FULL support) =  [-1 = empty]"; dim(std(SH));
quit;